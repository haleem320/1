# MEXC Futures Bot v34.4.5
# Keep these OFF while testing signals:
REAL_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false

# Optional runtime settings
SMART_PULLBACK_PROFILE=true
AUTO_INTERVAL_MINUTES=5
# Enforce a global cap of six concurrent positions.
POSITION_LIMIT_ENABLED=true
MAX_OPEN_POSITIONS=6
MAX_SAME_DIRECTION_POSITIONS=6
MAX_PREFLIGHT_CANDIDATES=15
BREAKOUT_REQUIRE_VOLUME=true
TARGET_LEVERAGE=12
# MEXC may cap leverage below 20x for some contracts; bot uses the contract max when lower.


# v34.5 HIGH-TIMEFRAME TREND ENGINE
# Main direction: 1D + 8H + 6H + 4H; confirmation: 1H; entry: 15m.
INTERVAL=Min15
ADAPTIVE_TP_ENABLED=true
TAKE_PROFIT_PCT=0.02
ADAPTIVE_TP_MAX_PCT=0.15
ADAPTIVE_TP_STEP_PCT=0.02
ADAPTIVE_TP_EXTEND_TRIGGER_PCT=0.02
TRAILING_TRIGGER_PCT=0.03
TRAILING_STOP_PCT=0.012
TARGET_LEVERAGE=12
